WEB_STATIC_IMAGE=registry.example/openakita-web-static
WEB_STATIC_IMAGE_TAG=0.0.1-g000000
WEB_BFF_IMAGE=registry.example/openakita-web-bff
WEB_BFF_IMAGE_TAG=0.0.1-g000000

WEB_BFF_PUBLIC_URL=https://openakita.ai
WEB_BFF_ACCOUNT_ISSUER=https://account.example
WEB_BFF_ACCOUNT_CLIENT_ID=openakita-web
WEB_BFF_ACCOUNT_CLIENT_SECRET=replace-with-confidential-client-secret
WEB_BFF_ACCOUNT_REDIRECT_URI=https://openakita.ai/auth/callback
WEB_BFF_ACCOUNT_POST_LOGOUT_REDIRECT_URI=https://openakita.ai/auth/logout/callback

WEB_BFF_MARKETPLACE_BASE_URL=https://marketplace.example/
WEB_BFF_MARKETPLACE_MACHINE_ID=openakita-web-bff
WEB_BFF_MARKETPLACE_MACHINE_SECRET=replace-with-dedicated-machine-secret
WEB_BFF_MARKETPLACE_ASSET_ALLOWED_ORIGINS=https://marketplace.example

WEB_BFF_PASS_BASE_URL=https://pass.example/
WEB_BFF_PASS_PUBLIC_URL=https://pass.example/
WEB_BFF_PASS_MACHINE_ID=openakita-web-bff
WEB_BFF_PASS_MACHINE_SECRET=replace-with-dedicated-pass-summary-secret

WEB_BFF_REDIS_URL=rediss://web-bff:replace-with-redis-password@redis.example:6379/0
WEB_BFF_SESSION_ENCRYPTION_KEYS=2026-08:replace-with-base64url-encoded-32-byte-key
WEB_BFF_TRUSTED_PROXIES=172.29.8.1/32
WEB_BFF_AUTH_RATE_LIMIT_PER_MINUTE=30
WEB_BFF_API_RATE_LIMIT_PER_MINUTE=240
