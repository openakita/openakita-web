{
  "name": "openakita-web",
  "version": "1.0.0",
  "private": true,
  "description": "OpenAkita official website frontend",
  "scripts": {
    "dev": "vite",
    "build:motion": "esbuild assets/ts/motion.ts --bundle --target=es2019 --format=iife --outfile=assets/js/motion.js --minify",
    "watch:motion": "esbuild assets/ts/motion.ts --bundle --target=es2019 --format=iife --outfile=assets/js/motion.js --watch",
    "typecheck": "tsc --noEmit",
    "prebuild": "npm run typecheck",
    "build": "vite build",
    "postbuild": "npm run verify:dist",
    "hash:dist": "node build-tools/hash-dist.mjs",
    "verify:dist": "node build-tools/verify-dist.mjs && node build-tools/verify-shell.mjs && node build-tools/verify-marketplace.mjs && node build-tools/verify-hub.mjs && node build-tools/verify-account-preview.mjs",
    "verify:shell": "node build-tools/verify-shell.mjs",
    "verify:marketplace": "node build-tools/verify-marketplace.mjs",
    "verify:hub": "node build-tools/verify-hub.mjs",
    "preview:hub-fixtures": "node build-tools/serve-hub-fixtures.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "esbuild": "^0.25.9",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
