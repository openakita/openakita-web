WEB_BFF_ENV=development
WEB_BFF_HTTP_ADDR=127.0.0.1:8080
WEB_BFF_PUBLIC_URL=http://127.0.0.1:8080

WEB_BFF_ACCOUNT_ISSUER=http://127.0.0.1:8090
WEB_BFF_ACCOUNT_CLIENT_ID=openakita-web-local
WEB_BFF_ACCOUNT_CLIENT_SECRET=replace-with-at-least-16-characters
WEB_BFF_ACCOUNT_REDIRECT_URI=http://127.0.0.1:8080/auth/callback
WEB_BFF_ACCOUNT_POST_LOGOUT_REDIRECT_URI=http://127.0.0.1:8080/auth/logout/callback

WEB_BFF_MARKETPLACE_BASE_URL=https://marketplace.fzstack.com/
WEB_BFF_MARKETPLACE_MACHINE_ID=openakita-web-bff
WEB_BFF_MARKETPLACE_MACHINE_SECRET=replace-with-the-same-dedicated-32-character-secret
# Optional comma-separated HTTPS asset origins in addition to Marketplace itself.
WEB_BFF_MARKETPLACE_ASSET_ALLOWED_ORIGINS=
WEB_BFF_PASS_BASE_URL=https://token-center.fzstack.com/
WEB_BFF_PASS_PUBLIC_URL=https://token-center.fzstack.com/
WEB_BFF_PASS_MACHINE_ID=openakita-web-bff
WEB_BFF_PASS_MACHINE_SECRET=replace-with-the-dedicated-pass-summary-secret
WEB_BFF_REDIS_URL=redis://127.0.0.1:6379/0
WEB_BFF_SESSION_ENCRYPTION_KEYS=local-2026-08:replace-with-base64url-encoded-32-byte-key
WEB_BFF_SESSION_TTL=720h
WEB_BFF_ACCOUNT_PAGE_PATH=../dist/account/index.html

# Comma-separated HTTPS origins. Account issuer origin is included automatically.
WEB_BFF_AVATAR_ALLOWED_ORIGINS=
# Required in production; reserved for the edge proxy allowlist.
WEB_BFF_TRUSTED_PROXIES=
WEB_BFF_AUTH_RATE_LIMIT_PER_MINUTE=30
WEB_BFF_API_RATE_LIMIT_PER_MINUTE=240
